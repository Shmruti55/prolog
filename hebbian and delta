
#hebbian learning rule
import numpy as np

X = np.array([[-1,-1], [-1,1], [1,-1], [1,1]])
T = np.array([-1,1,1,1])
w = np.zeros(2)
b = 0

for x, t in zip(X, T):
    w += x * t
    b += t

print("Weights:", w, "Bias:", b)
for x in X:
    y = 1 if np.dot(w, x) + b >= 0 else -1
    print(x, "->", y)


#delta learning rule
import numpy as np

X = np.array([[0,0], [0,1], [1,0], [1,1]])
T = np.array([0,0,0,1])
w = np.zeros(2)
b, lr = 0.0, 0.1

for _ in range(20):
    for x, t in zip(X, T):
        y = np.dot(w, x) + b
        e = t - y
        w += lr * e * x
        b += lr * e

print("Weights:", w, "Bias:", b)
for x in X:
    print(x, "->", round(np.dot(w, x) + b, 3))
