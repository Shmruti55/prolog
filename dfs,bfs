# Experiment 3: Uninformed search - DFS and BFS to reach a goal state

#DFS
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

def dfs(graph, start, goal):
    stack = [[start]]
    visited = set()

    while stack:
        path = stack.pop()
        node = path[-1]

        if node == goal:
            return path

        if node not in visited:
            visited.add(node)
            for nb in reversed(graph[node]):
                stack.append(path + [nb])

    return None

print("DFS path A -> F:", dfs(graph, 'A', 'F'))



#BFS
from collections import deque

graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

def bfs(graph, start, goal):
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == goal:
            return path

        for nb in graph[node]:
            if nb not in visited:
                visited.add(nb)
                queue.append(path + [nb])

    return None

print("BFS path A -> F:", bfs(graph, 'A', 'F'))
