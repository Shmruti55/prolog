import numpy as np
 
def step(z):
    return 1 if round(z, 9) >= 0 else 0        # step activation (round fixes float noise)
 
def train_perceptron(X, y, epochs=10, lr=0.1):
    w, b = np.zeros(X.shape[1]), 0.0
    for _ in range(epochs):
        for xi, ti in zip(X, y):
            error = ti - step(np.dot(xi, w) + b)           # error = target - prediction
            w = w + lr * error * xi                        # weight update
            b = b + lr * error                             # bias update
    return w, b
 
def predict(X, w, b):
    return [step(np.dot(x, w) + b) for x in X]
 
X   = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])
AND = np.array([0, 0, 0, 1])
OR  = np.array([0, 1, 1, 1])
XOR = np.array([0, 1, 1, 0])
 
for name, y in [("AND", AND), ("OR", OR), ("XOR", XOR)]:
    w, b = train_perceptron(X, y)
    print(f"{name}: weights={w}, bias={b:.1f}, output={predict(X, w, b)}, "
          f"target={y.tolist()}")
 
# XOR is NOT linearly separable -> a single perceptron fails.
# Fix: two layers.  XOR = AND( OR(x1,x2), NAND(x1,x2) )
NAND = 1 - AND
w1, b1 = train_perceptron(X, OR)                           # hidden neuron 1
w2, b2 = train_perceptron(X, NAND)                         # hidden neuron 2
H = np.array(list(zip(predict(X, w1, b1), predict(X, w2, b2))))   # hidden outputs
w3, b3 = train_perceptron(H, XOR)                          # output neuron
print("XOR with 2 layers:", predict(H, w3, b3), "target:", XOR.tolist())
