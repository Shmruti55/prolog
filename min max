import math
 
def minimax(depth, index, is_max, scores, height):
    if depth == height:                    # leaf node -> return its score
        return scores[index]
    left  = minimax(depth + 1, index * 2,     not is_max, scores, height)
    right = minimax(depth + 1, index * 2 + 1, not is_max, scores, height)
    return max(left, right) if is_max else min(left, right)
 
scores = [3, 5, 6, 9, 1, 2, 0, -1]         # leaf values of a binary game tree
height = int(math.log2(len(scores)))       # 8 leaves -> height 3
print("The optimal value is:", minimax(0, 0, True, scores, height))
